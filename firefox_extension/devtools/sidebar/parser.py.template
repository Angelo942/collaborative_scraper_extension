"""Parser for {{HOST}}, generated by the Collaborative Scraper dev mode.

Built on {{URL}} ({{DATE}}).
Check it on a few more pages of the same kind: XPaths built from one page can
be too specific.

To use it in a plugin, copy this file into the plugin's parse_html package and
register it in register(reg):

    from .parse_html.{{MODULE}} import extract_elements
    reg.parser("{{HOST}}", extract_elements)
{{#STANDALONE}}

To try it without the server, save the page (dev mode -> "Page HTML") and run:

    python {{MODULE}}.py page.html > items.csv
{{/STANDALONE}}
"""
from __future__ import annotations

{{#STANDALONE}}
import csv
import json
import sys
{{/STANDALONE}}
import re
from urllib.parse import urljoin

from lxml import html

{{#PLUGIN}}
from collaborative_scraper.api import Result, ScrapedElement
{{/PLUGIN}}
{{#STANDALONE}}
try:
    from collaborative_scraper.api import Result, ScrapedElement
except ImportError:  # running standalone, without the server installed
    class ScrapedElement:
        pass

    class Result:
        def __init__(self, elements, metadata=None):
            self.elements = elements
            self.metadata = metadata
{{/STANDALONE}}

ORIGIN = {{ORIGIN}}
{{#STANDALONE}}
PAGE_PATH = {{PAGE_PATH}}  # the page this parser was built on
{{/STANDALONE}}
ITEMS_XPATH = {{ITEMS_XPATH}}


class {{CLASS}}(ScrapedElement):
    FIELDS = {{FIELDS}}

    def __init__(self, base_url):
        super().__init__()
{{INIT}}
        self._base_url: str = base_url

    def __repr__(self):
        return f"{{CLASS}}({{REPR}})"

    def load(self, node: html.HtmlElement) -> None:
{{LOAD}}


def extract_elements(html_page: str, path: str, get_parameters: dict,
                     post_parameters: dict) -> Result | None:
    page = html.fromstring(html_page)
    base_url = urljoin(ORIGIN, path)

    elements = []
    for node in page.xpath(ITEMS_XPATH):
        element = {{CLASS}}(base_url)
        element.load(node)
        elements.append(element)

    metadata = {
{{METADATA}}
    }

    # Nothing found: the page isn't fully loaded (or isn't this kind of page).
    values = [getattr(e, name) for e in elements for name in {{CLASS}}.FIELDS] + list(metadata.values())
    if not any(value is not None and value != [] for value in values):
        return None
    return Result(elements, metadata)


def _first(node, xpath):
    found = node.xpath(xpath)
    return found[0] if found else None


def _text(node, xpath):
    """Whitespace-normalised text of the first match, or None."""
    found = _first(node, xpath)
    if found is None:
        return None
    text = found if isinstance(found, str) else found.text_content()
    return " ".join(text.split())


def _attr(node, xpath, name, base_url=None):
    """Attribute of the first match, or None. Made absolute when base_url is given."""
    found = _first(node, xpath)
    if found is None or isinstance(found, str):
        return None
    value = found.get(name)
    if value is not None and base_url is not None:
        value = urljoin(base_url, value)
    return value


def _click(node, xpath, wait_for):
    """CLICK instruction for the first match, or None: the request a scraper sends
    to the extension, which clicks it in the page, waits for the wait_for element
    to change (None: anything), then sends the page. The paths are made absolute,
    as the browser evaluates them on the whole page."""
    found = _first(node, xpath)
    if found is None or isinstance(found, str):
        return None
    tree = node.getroottree()
    if wait_for and wait_for.startswith("."):
        wait_for = tree.getpath(node) + wait_for[1:]
    return {"type": "CLICK", "xpath": tree.getpath(found), "wait_for": wait_for}


# The minus is not a hyphen inside a word, as in "ABC-123".
_NUMBER = re.compile(r"(?:(?<![A-Za-z0-9_-])-)?[0-9]+(?:[.,][0-9]+)*")


def _number(text):
    """First number in the text, or None: "1,299.00 €" -> 1299.0, "12 results" -> 12."""
    match = _NUMBER.search(text or "")
    if match is None:
        return None
    number = match.group()
    separator = _decimal_separator(number)
    if not separator:
        return int(_without_separators(number))
    whole, _, fraction = number.rpartition(separator)
    return float(_without_separators(whole) + "." + fraction)


def _decimal_separator(number):
    """The last separator when both are used ("1.234,5", "1,234.5"). A repeated
    separator ("1.234.567") and a lone comma before three digits ("1,234") group thousands."""
    separators = re.sub(r"[^.,]", "", number)
    if not separators:
        return ""
    last = separators[-1]
    if ("," if last == "." else ".") in separators:
        return last
    if len(separators) > 1:
        return ""
    return "" if last == "," and re.search(r",[0-9]{3}$", number) else last


def _without_separators(digits):
    return re.sub(r"[.,]", "", digits)
{{#STANDALONE}}


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit(f"usage: python {sys.argv[0]} saved_page.html > items.csv")
    with open(sys.argv[1], encoding="utf-8") as f:
        result = extract_elements(f.read(), PAGE_PATH, {}, {})
    if result is None:
        sys.exit("Nothing found: this page doesn't match the parser.")
    metadata = result.metadata or {}
    writer = csv.writer(sys.stdout)
    writer.writerow(list({{CLASS}}.FIELDS) + list(metadata))
    for element in result.elements:
        values = [getattr(element, name) for name in {{CLASS}}.FIELDS] + list(metadata.values())
        writer.writerow([json.dumps(v) if isinstance(v, list) else v for v in values])
{{/STANDALONE}}
