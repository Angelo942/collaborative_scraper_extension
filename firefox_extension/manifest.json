{
  "manifest_version": 2,
  "name": "Collaborative Scraper",
  "version": "2.0",
  "description": "Collaborative Scraper is a tool for teams to store the web pages they visit on specific websites in a shared location.",

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "http://*/*",
    "https://*/*"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Start sharing pages on this tab"
  },

  "background": {
    "scripts": ["background.js", "devtools/background.js"],
    "persistent": false
  },

  "sidebar_action": {
    "default_title": "Parser builder",
    "default_panel": "devtools/sidebar/sidebar.html",
    "default_icon": "icons/icon-32.png",
    "open_at_install": false
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
